# SpeakUp Environment Configuration
# Copy this file to .env and update values as needed

# Application
APP_NAME=SpeakUp
APP_VERSION=0.1.0
APP_ENV=development

# Database
DATABASE_URL=sqlite:///speakup.db
# Override to use a different location:
# DATABASE_URL=sqlite:///C:/Users/YourName/speakup/speakup.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=speakup.log

# Default User
DEFAULT_USER_NAME=Local User

# Recordings storage path (relative to project root)
RECORDINGS_DIR=recordings

# Future: OpenAI / Whisper API
# OPENAI_API_KEY=sk-...
# WHISPER_MODEL=whisper-1

# AI Feedback Engine (Chunk 8)
# AI_FEEDBACK_BACKEND=local        # "local" (default, no API) | "llm" (requires key)
# OPENAI_API_KEY=sk-...            # Required for LLM feedback — never commit this
# AI_FEEDBACK_MODEL=gpt-4o-mini    # or gpt-4o for higher quality
# AI_FEEDBACK_TIMEOUT_S=30         # API timeout in seconds
# AI_FEEDBACK_MAX_TOKENS=800       # Max tokens in LLM response
# AI_FEEDBACK_MIN_WORDS=20         # Min transcript words before LLM analysis

# Transcription (Chunk 4)
# TRANSCRIPTION_BACKEND=faster_whisper  # or "mock" for tests
# WHISPER_MODEL_SIZE=base               # tiny | base | small | medium | large-v2 | large-v3
# WHISPER_MODEL_PATH=                   # leave empty to auto-download from HuggingFace
# WHISPER_DEVICE=cpu                    # cpu | cuda
# WHISPER_COMPUTE_TYPE=int8             # int8 | float16 | float32
# WHISPER_LANGUAGE=en                   # empty = auto-detect
# WHISPER_CPU_THREADS=4
# WHISPER_BEAM_SIZE=5

# Future: Analysis thresholds
# MIN_SPEAKING_DURATION=60
# TARGET_WORDS_PER_MINUTE=130
